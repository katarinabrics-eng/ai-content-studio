# ─── Vercel / Production ─────────────────────────────────────────────────────
# Zkopíruj do .env.local pro lokální vývoj. Na Vercelu nastav v Settings → Environment Variables.

# URL aplikace (na Vercelu: https://tvuj-projekt.vercel.app, pak vlastní doména)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (povinné pro ukládání projektů, draftů, storage)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe (platby)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google Calendar (service account JSON jako řetězec)
GOOGLE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# E-mail po platbě (Resend)
RESEND_API_KEY=re_...

# URL site pro webhook → send-email (Vercel: https://studiolucifera.cz)
NEXT_PUBLIC_SITE_URL=https://studiolucifera.cz

# AI a scrape (analýza značky: Firecrawl + OpenAI)
OPENAI_API_KEY=sk-...
FIRECRAWL_API_KEY=fc-...

# Admin přístup
ADMIN_PASSWORD=...
ADMIN_SETUP_TOKEN=volitelný-token-pro-prvni-nastaveni-hesla

# Volitelné
# NEXT_PUBLIC_ENABLE_CODE_PIN_ACCESS=true
# SUPABASE_EXPORTS_BUCKET=exports
# SUPABASE_VISUALS_BUCKET=generated-visuals
# OPENAI_DEFAULT_MODE=batch
# OPENAI_BATCH_ENABLED=true
# VISUAL_FAST_MODE=true
