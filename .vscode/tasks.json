{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start dev server (content-studio)",
      "type": "shell",
      "command": "npm run dev:safe",
      "options": {
        "cwd": "${workspaceFolder}/apps/content-studio",
        "isBackground": true,
        "problemMatcher": {
          "pattern": { "regexp": "^$" },
          "background": {
            "activeOnStart": true,
            "beginsPattern": "Starting",
            "endsPattern": "Ready in"
          }
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "group": "build"
    }
  ]
}
